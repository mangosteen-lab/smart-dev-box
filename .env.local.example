# Copy this to .env.local and fill in values
# AI features (natural language commands + input correction) require an OpenAI API key.
# Without this, all tools still work — only the AI command bar is hidden.
OPENAI_API_KEY=

# Optional: override the OpenAI model used for AI routing (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
